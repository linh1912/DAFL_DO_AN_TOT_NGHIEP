<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="DAFL Continuous Testing Automation Suite" verbose="1">
    <parameter name="browser" value="chrome"/>

    <listeners>
        <listener class-name="vn.dafl.reportConfig.AllureTestListener"/>
    </listeners>

    <test name="E2E Customer Journey Flow">
        <classes>
            <class name="vn.dafl.tests.EndToEndShoppingFlowTest"/>
        </classes>
    </test>

    <test name="Negative &amp; Exception Scenarios">
        <classes>
            <class name="vn.dafl.tests.NegativeAndExceptionScenariosTest"/>
        </classes>
    </test>

    <test name="Regression - DAFL E-Commerce Modules">
        <classes>
            <class name="vn.dafl.tests.AuthTest"/>
            <class name="vn.dafl.tests.CatalogAndSearchTest"/>
            <class name="vn.dafl.tests.ProductDetailTest"/>
            <class name="vn.dafl.tests.CartManagementTest"/>
            <class name="vn.dafl.tests.CheckoutAndOrderTest"/>
            <class name="vn.dafl.tests.OrderCancellationTest"/>
            <class name="vn.dafl.tests.ProfileAndAddressTest"/>
            <class name="vn.dafl.tests.HomeHeroTest"/>
            <class name="vn.dafl.tests.NotFoundPageTest"/>
            <class name="vn.dafl.tests.AdminAndNewsletterTest"/>
        </classes>
    </test>
</suite>
