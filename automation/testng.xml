            <class name="vn.dafl.tests.web.home.HomeHeroTest"/>
            <class name="vn.dafl.tests.web.home.NotFoundPageTest"/>
            <class name="vn.dafl.tests.web.home.NewsletterTest"/>
            <class name="vn.dafl.tests.web.membership.MembershipTest"/>
