<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="DAFL Continuous Testing Automation Suite" verbose="1">
    <parameter name="browser" value="chrome"/>

    <listeners>
        <listener class-name="vn.dafl.reportConfig.AllureTestListener"/>
    </listeners>

    <!-- Khoi 1: Web ban hang (13 lop, 107 test) -->
    <test name="Web - Shop">
        <classes>
            <class name="vn.dafl.tests.web.AuthTest"/>
            <class name="vn.dafl.tests.web.CatalogAndSearchTest"/>
            <class name="vn.dafl.tests.web.ProductDetailTest"/>
            <class name="vn.dafl.tests.web.CartManagementTest"/>
            <class name="vn.dafl.tests.web.CheckoutAndOrderTest"/>
            <class name="vn.dafl.tests.web.OrderCancellationTest"/>
            <class name="vn.dafl.tests.web.ProfileAndAddressTest"/>
            <class name="vn.dafl.tests.web.HomeHeroTest"/>
            <class name="vn.dafl.tests.web.NotFoundPageTest"/>
            <class name="vn.dafl.tests.web.NewsletterTest"/>
            <class name="vn.dafl.tests.web.MembershipTest"/>
            <class name="vn.dafl.tests.web.EndToEndShoppingFlowTest"/>
            <class name="vn.dafl.tests.web.NegativeAndExceptionScenariosTest"/>
        </classes>
    </test>

    <!-- Khoi 2: Admin (5 lop, 38 test) -->
    <test name="Admin">
        <classes>
            <class name="vn.dafl.tests.admin.AdminAndNewsletterTest"/>
            <class name="vn.dafl.tests.admin.AdminDetailTest"/>
            <class name="vn.dafl.tests.admin.AdminCrudTest"/>
            <class name="vn.dafl.tests.admin.AdminWave13Test"/>
            <class name="vn.dafl.tests.admin.AdminUploadTest"/>
        </classes>
    </test>
</suite>
